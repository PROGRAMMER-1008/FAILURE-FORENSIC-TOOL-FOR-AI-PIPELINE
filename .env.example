# Local configuration. Never commit .env or share its contents.
# Loaded only by start-local.cmd / python -m ffv2.local. Restart after changes.
# Process environment variables override these values.
FF_MODE=local
FF_DATABASE_URL=sqlite:///data/local-ai.db
# Keep fake for synthetic testing. Change to groq when you add your key.
FF_PROVIDER=fake
FF_GROQ_API_KEY=
FF_PRODUCER_MODEL=openai/gpt-oss-20b
FF_JUDGE_MODEL=openai/gpt-oss-20b
FF_OLLAMA_URL=http://127.0.0.1:11434
FF_DEADLINE_SECONDS=45
FF_MAX_CHARACTERS=20000
FF_MAX_UPLOAD_BYTES=2000000
